# Copy this file to .env and fill in your own values (.env is not tracked by git).
#
# make includes it, so write it in Makefile syntax.
# Values can be written literally or refer to shell environment variables.

# Incoming Webhook URL for Slack notifications. Required.
# make spec / impl / review stop with an error if it is not set.
SLACK_WEBHOOK_URL =

# Strong / fast model IDs. By default they come from the environment variables CLAUDE_CODE_OPUS_MODEL / CLAUDE_CODE_SONNET_MODEL.
# If you do not define those, write the IDs here. Use = rather than ?= (the Makefile defines them first, so ?= has no effect).
# STRONG_MODEL = <strong model ID>
# FAST_MODEL = <fast model ID>

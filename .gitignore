*.crx
*.pem
.DS_Store

# Claude Code settings（ディレクトリ全体ではなく個人設定ファイルだけを無視する。
# ai-flow/.claude/*-permissions.json はフロー本体の共有ファイルなのでコミット対象）
.claude/settings.json
.claude/settings.local.json

# Temporary files
*.tmp
*.temp
*~

# Editor files
.vscode/
.idea/
*.swp
*.swo


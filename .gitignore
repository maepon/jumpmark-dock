Thumbs.db
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db

# Node.js (if used for development tools)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Development tools
dist/
build/

# Chrome extension zip files
*.zip
jumpmark-dock-v*.zip

# Logs
logs/
*.log

# Environment variables
.env

# Temporary files on ai-flow
tmp/
ai-flow/tmp/

# グローバル gitignore の `.claude` ルールで無視されるため明示的に復活させる
# （settings.json / settings.local.json のような個人設定ファイル名は対象に含めない）
!ai-flow/.claude/
!ai-flow/.claude/*-permissions.json
